{
  "name": "claude-agent-room",
  "version": "1.3.0",
  "description": "Visualiseur temps réel d'un agent Claude orchestrateur et de ses sous-agents dans une chambre en pixel art.",
  "main": "server/index.js",
  "bin": {
    "claude-agent-room": "bin/cli.js",
    "claude-agent-room-hook": "bridge/claude-hook.js"
  },
  "files": [
    "bin/",
    "bridge/",
    "server/",
    "tui/",
    "advisor/",
    "public/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/cli.js start",
    "open": "node bin/cli.js start --open",
    "dev": "node --watch server/index.js",
    "demo": "node bin/cli.js demo",
    "doctor": "node bin/cli.js doctor",
    "hooks:install": "node bin/cli.js hooks install",
    "hooks:install:project": "node bin/cli.js hooks install --project",
    "hooks:remove": "node bin/cli.js hooks remove",
    "hooks:status": "node bin/cli.js hooks status",
    "watch:transcript": "node bin/cli.js watch",
    "test": "node --test test/bridge.test.js test/server.test.js test/tui.test.js test/features.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "subagents",
    "visualizer",
    "pixel-art",
    "websocket"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MehenniIslam/claude-agent-room.git"
  },
  "bugs": {
    "url": "https://github.com/MehenniIslam/claude-agent-room/issues"
  },
  "homepage": "https://github.com/MehenniIslam/claude-agent-room#readme",
  "author": "MehenniIslam"
}
